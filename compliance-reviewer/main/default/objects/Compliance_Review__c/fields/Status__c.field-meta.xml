<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Outcome of the analysis: whether discrepancies were found, none were found, or the AI invocation failed. Maps to ComplianceReviewResult.status.</description>
    <inlineHelpText>The overall result of this compliance review.</inlineHelpText>
    <label>Status</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>No Issues Found</fullName>
                <default>false</default>
                <label>Aligned</label>
            </value>
            <value>
                <fullName>Issues Found</fullName>
                <default>false</default>
                <label>Needs Attention</label>
            </value>
            <value>
                <fullName>Error</fullName>
                <default>false</default>
                <label>Analysis Failed</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
